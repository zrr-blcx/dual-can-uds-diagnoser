digraph RelayModuleWiring {
  // 2路5V光耦继电器模块 实物端子接线图（Phase 4）
  rankdir=TB;
  graph [bgcolor="white", fontname="Microsoft YaHei", label="Phase 4 继电器模块实物接线图（2路 5V 光耦隔离 SRD-05VDC-SL-C）", labelloc=t, fontsize=18, fontcolor="#1A1B1C", pad="0.3", nodesep="0.4", ranksep="0.55"];
  node [fontname="Microsoft YaHei", style="rounded,filled", fontsize=12, color="#3B6EA5", fontcolor="#1A1B1C"];
  edge [fontname="Microsoft YaHei", fontsize=10, color="#666666", arrowsize=0.7];

  // ============ 继电器模块 ============
  subgraph cluster_relay {
    label="继电器模块（实物端子）";
    style=filled; color="#C62828"; fillcolor="#FFF5F5"; fontcolor="#1A1B1C"; penwidth=2;

    // 供电与控制侧（下排端子）
    pwr [label="下排供电/控制端子（模块本身不带按钮）\nDC+  ← 5V（F407 VOUT2）\nDC-  → GND（面包板蓝轨）\nIN1  → 外部轻触按钮 → GND（或临时用杜邦线瞬时碰 GND）\nIN2  → 外部轻触按钮 → GND（或临时用杜邦线瞬时碰 GND）\nS1/S2 丝印 = H / L / COM（触发电平选择，不是电源）\n本方案低电平触发：跳线 COM ↔ L\n禁止把 IN 长期接 GND：继电器会一直吸合、CH2 持续短接总线", fillcolor="#E3F2FD", color="#1565C0"];

    // CH1 触点侧（上排左）
    ch1 [label="CH1 触点（上排左）\nCOM → F407 侧 CANH\nNC  → 总线侧 CANH\nNO  → 空着\n\n默认导通（COM↔NC）\n吸合 = 断开 CANH，模拟通信丢失\n实测该路径不能作为 Bus-Off 判据（TEC 可冻结在 128）", fillcolor="#FFCDD2", color="#C62828"];

    // CH2 触点侧（上排右）
    ch2 [label="CH2 触点（上排右）\nCOM → CANH 侧\nNO  → CANL 侧\nNC  → 空着\n\n默认断开（COM↔NO）\n吸合 = 短接 CANH-CANL\n这是已实测的 Bus-Off 注入路径\n持续时间按测试判据控制并立即释放", fillcolor="#FFCDD2", color="#C62828"];
  }

  // ============ 台架设备 ============
  f407vcc [label="F407 VOUT2（5V）", shape=box, fillcolor="#E8F1FB", color="#3B6EA5"];
  f407can [label="F407 SN65HVD230 出口\nCANH / CANL", shape=box, fillcolor="#E8F1FB", color="#3B6EA5"];
  bus [label="总线主干（CANable + 总线侧）\nCANH / CANL", shape=box, fillcolor="#F7F7F5", color="#6B7280"];
  gnd [label="公共 GND（面包板蓝轨）", shape=box, fillcolor="#E3E3E3", color="#37474F", penwidth=2];
  btn1 [label="外部按钮1（模块无按钮）\nIN1 ↔ 按钮 ↔ GND", shape=box, fillcolor="#FFF8DC", color="#B8860B"];
  btn2 [label="外部按钮2（模块无按钮）\nIN2 ↔ 按钮 ↔ GND", shape=box, fillcolor="#FFF8DC", color="#B8860B"];

  // ============ 连线 ============
  f407vcc -> pwr [label="DC+（5V）", color="#1565C0", penwidth=2];
  pwr -> gnd [label="DC-（GND）", color="#555555"];
  pwr -> btn1 [label="IN1", color="#B8860B", style=dashed, constraint=false];
  pwr -> btn2 [label="IN2", color="#B8860B", style=dashed, constraint=false];
  btn1 -> gnd [style=dashed, color="#B8860B"];
  btn2 -> gnd [style=dashed, color="#B8860B"];

  f407can -> ch1 [label="CANH（F407 侧）", color="#C62828", penwidth=2];
  ch1 -> bus [label="CANH（总线侧，经 NC）", color="#C62828"];
  ch2 -> bus [label="短接 CANH-CANL", color="#D32F2F", style=dashed, constraint=false];
  f407can -> gnd [label="收发器 GND", color="#555555"];

  // ============ 说明 ============
  note [shape=note, fillcolor="#FFF8DC", color="#B8860B", fontsize=11,
        label="要点：\n1. 先断电用万用表确认上排端子 NC/COM/NO：默认蜂鸣的一对 = COM+NC\n2. CH1 常闭串 CANH，用于模拟通信丢失；CH2 常开跨 CANH-CANL，用于 Bus-Off\n3. 5V 只供线圈，不碰收发器；3.3V 世界不受影响\n4. 低电平触发：按钮按下 IN 接 GND → 吸合；松开 → 释放\n5. r11 约 2 秒观察到 3 次自动恢复；W2-10 约 8 秒验证复位分支。只在受控台架执行，达到判据立即松开"];
}
